#!/usr/bin/env bash

# Builds Yonder for Linux desktops as target/release/yonder-linux-<arch>.tar.gz.
#
# The archive unpacks to yonder.app/ (yonder-dev.app/ and so on for other
# channels):
#   bin/yonder                     the command-line launcher
#   libexec/yonder-editor          the app
#   lib/                           shared libraries older systems may lack
#   share/yonder/machines/         the static `yonder` program for Linux
#                                  machines, which the app installs over SSH
#   share/applications, share/icons
#
# script/install-linux puts it in ~/.local. Building needs the Linux desktop
# development packages (script/linux installs them), clang and lld 12+, musl-gcc
# for the machine program, and cargo-about for the license list.
# script/build-linux-docker does all of it in a container instead.

set -euxo pipefail
source script/lib/blob-store.sh

help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz of Yonder for Linux.

Options:
  -h, --help        Display this help and exit.
  --flatpak         Set ZED_BUNDLE_TYPE=flatpak so that this can be included in system info
  --require-sentry  Require Sentry credentials, CLI, and successful symbol upload.
  --skip-sentry     Skip symbol upload (the default when sentry-cli or SENTRY_AUTH_TOKEN is missing).
  "
}

require_sentry=false
skip_sentry=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export ZED_BUNDLE_TYPE=flatpak
            shift
            ;;
        --require-sentry)
            require_sentry=true
            shift
            ;;
        --skip-sentry)
            skip_sentry=true
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

if [[ -n "${RUSTFLAGS+x}" || -n "${CARGO_ENCODED_RUSTFLAGS+x}" ]]; then
    echo "Unset RUSTFLAGS and CARGO_ENCODED_RUSTFLAGS; put extra flags in target rustflags in .cargo/config.toml so bundle flags are preserved." >&2
    exit 1
fi

if "$require_sentry" && "$skip_sentry"; then
    echo "--require-sentry and --skip-sentry cannot be used together." >&2
    exit 1
fi

if "$skip_sentry"; then
    echo "Skipping Sentry upload for local packaging."
elif ! command -v sentry-cli >/dev/null 2>&1; then
    if "$require_sentry"; then
        echo "--require-sentry needs sentry-cli for symbol upload." >&2
        exit 1
    fi
    skip_sentry=true
elif [[ -z "${SENTRY_AUTH_TOKEN:+set}" ]]; then
    if "$require_sentry"; then
        echo "--require-sentry needs SENTRY_AUTH_TOKEN for symbol upload." >&2
        exit 1
    fi
    skip_sentry=true
fi

export ZED_BUNDLE=true

# The channel is baked in at compile time; ZED_RELEASE_CHANNEL overrides the
# repository's default (dev), as script/install-linux does with stable.
channel="${ZED_RELEASE_CHANNEL:-$(<crates/zed/RELEASE_CHANNEL)}"
target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version zed)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

export ZED_COMMIT_SHA="${ZED_COMMIT_SHA:-$(git rev-parse HEAD 2>/dev/null || echo dev)}"

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
arch=$(uname -m)

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

export CC=${CC:-$(which clang)}
# WebRTC's headers need a C++ compiler newer than Ubuntu 22.04's GCC 11, which
# rejects them ("declaration changes meaning"); clang accepts them.
export CXX=${CXX:-$(which clang++)}
lld=${LLD:-$("$CC" -print-prog-name=ld.lld)}
if [[ "$lld" != /* || ! -x "$lld" ]]; then
    echo "Bundling requires an absolute executable linker path; set LLD (e.g. LLD=/usr/bin/ld.lld-18)." >&2
    exit 1
fi
lld_version=$("$lld" --version)
if [[ ! "$lld_version" =~ LLD\ ([0-9]+)\. ]] || (( BASH_REMATCH[1] < 12 )); then
    echo "Bundling requires LLD 12 or newer for safe ICF; set LLD to a supported linker (e.g. LLD=/usr/bin/ld.lld-18)." >&2
    exit 1
fi

# The app and its launcher.
cargo --config .cargo/bundle-config.toml rustc --release --target "${target_triple}" --package zed --bin yonder -- -C linker="$CC" -C llvm-args=-addrsig -C link-arg=-fuse-ld=lld -C link-arg=--ld-path="$lld" -C link-arg=-Wl,--icf=safe
cargo --config .cargo/bundle-config.toml build --release --target "${target_triple}" --package cli

# The program for Linux machines: static, so it runs on servers that have no
# display libraries. Built in its own invocation so the app's features don't
# leak into it, and on the dev channel like the machine servers the Mac app
# installs, so both apps' machines run the same thing.
env -u ZED_RELEASE_CHANNEL -u CC -u CXX script/build-yonder-headless "${arch}"
machine_program="${target_dir}/yonder-headless/yonder-linux-${arch}"
machine_version="$("${machine_program}" server version)"

if ! "$skip_sentry"; then
    echo "Uploading debug symbols to sentry..."
    for attempt in 1 2 3; do
        if sentry-cli debug-files upload --include-sources --wait \
            "${target_dir}/${target_triple}"/release/yonder; then
            break
        fi
        if [ "$attempt" -eq 3 ]; then
            echo "All sentry upload attempts failed; refusing to package binaries without uploaded symbols." >&2
            exit 1
        fi
    done
fi

# Keep the debug info beside the build; the shipped binaries are stripped. We
# use llvm-objcopy because GNU objcopy on older distros doesn't understand CREL
# sections produced by newer LLVM.
llvm-objcopy --only-keep-debug "${target_dir}/${target_triple}/release/yonder" "${target_dir}/${target_triple}/release/yonder.dbg"

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT
app_dir="${temp_dir}/yonder$suffix.app"

mkdir -p "${app_dir}/bin" "${app_dir}/libexec"
llvm-objcopy --strip-unneeded "${target_dir}/${target_triple}/release/yonder" "${app_dir}/libexec/yonder-editor"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli" "${app_dir}/bin/yonder"

machines_dir="${app_dir}/share/yonder/machines/linux-${arch}"
mkdir -p "${machines_dir}"
cp "${machine_program}.gz" "${machines_dir}/yonder.gz"
echo "${machine_version}" > "${machines_dir}/yonder.version"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/yonder |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${app_dir}/lib"
cp $(find_libs) "${app_dir}/lib"

case "$channel" in
  preview) export APP_NAME="Yonder Preview"; APP_ID="io.github.aabdlwahab.Yonder-Preview" ;;
  nightly) export APP_NAME="Yonder Nightly"; APP_ID="io.github.aabdlwahab.Yonder-Nightly" ;;
  dev) export APP_NAME="Yonder Dev"; APP_ID="io.github.aabdlwahab.Yonder-Dev" ;;
  *) export APP_NAME="Yonder"; APP_ID="io.github.aabdlwahab.Yonder" ;;
esac

# Icons, named after the app ID so the dock matches the window to its icon.
icon_suffix="$suffix"
[[ -f "crates/zed/resources/app-icon$icon_suffix.png" ]] || icon_suffix=""
mkdir -p "${app_dir}/share/icons/hicolor/512x512/apps" "${app_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/zed/resources/app-icon$icon_suffix.png" "${app_dir}/share/icons/hicolor/512x512/apps/$APP_ID.png"
cp "crates/zed/resources/app-icon$icon_suffix@2x.png" "${app_dir}/share/icons/hicolor/1024x1024/apps/$APP_ID.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="yonder"
export APP_ICON="$APP_ID"
export APP_WM_CLASS="$APP_ID"
export APP_ARGS="%U"
mkdir -p "${app_dir}/share/applications"
envsubst < "crates/zed/resources/zed.desktop.in" > "${app_dir}/share/applications/$APP_ID.desktop"
chmod +x "${app_dir}/share/applications/$APP_ID.desktop"

cp "assets/licenses.md" "${app_dir}/licenses.md"

archive="yonder-linux-${arch}.tar.gz"
rm -f "${target_dir}/release/yonder"*"-linux-${arch}.tar.gz"
tar -czf "${target_dir}/release/$archive" -C "${temp_dir}" "yonder$suffix.app"
echo "Built ${target_dir}/release/${archive}"
