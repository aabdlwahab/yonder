# User service for the Yonder hub. Install with:
#   cp yonder-hub ~/.local/bin/
#   cp yonder-hub.service ~/.config/systemd/user/
#   systemctl --user enable --now yonder-hub
#   loginctl enable-linger $USER   # keep it running after logout
[Unit]
Description=Yonder hub: runs agent threads for the Mac and phone
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/yonder-hub serve
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=yonder_hub=info

[Install]
WantedBy=default.target
